# Copie este arquivo para .env.local e preencha os valores.
# Nunca commite o .env.local.

# Supabase (público, usado no browser)
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (somente servidor, ignora RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Z-API (WhatsApp): webhook e alertas
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# eKyte (sincronização)
EKYTE_API_KEY=

# IA (análise de WhatsApp)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
